# HTTPS ve tek alan adı yönlendirmesi
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^baskentdestek\.com$ [NC]
RewriteRule ^ https://baskentdestek.com%{REQUEST_URI} [R=301,L]

# Klasör bağlantıları
DirectorySlash On

# Özel 404 sayfası
ErrorDocument 404 /404.html

# SEO ve güvenlik başlıkları
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
</IfModule>
